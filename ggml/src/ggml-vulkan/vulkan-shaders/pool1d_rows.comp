#version 450

#include "types.glsl"

// POOL_1D with one workgroup per output element: the threads share the window and reduce in shared memory.
// Used for wide windows (a max or mean over a whole row), where pool1d.comp runs the window in one thread.

layout(push_constant) uniform parameter {
    uint IL;
    uint OL;
    uint OC;
    uint pelements;
    uint op;
    int k0;
    int s0;
    int p0;
} p;

#define BLOCK_SIZE 256
#define FLT_MAX 3.402823466e+38F
#define OP_POOL_MAX 0u
#define OP_POOL_AVG 1u

layout (local_size_x = BLOCK_SIZE, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly buffer X {A_TYPE data_a[];};
layout(binding = 1) writeonly buffer D {D_TYPE data_d[];};

shared float tmp[BLOCK_SIZE];

void main() {
    // uniform per workgroup, so the whole group leaves together before any barrier
    const uint idx = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    if (idx >= p.pelements || (p.op != OP_POOL_MAX && p.op != OP_POOL_AVG)) {
        return;
    }
    const uint tid = gl_LocalInvocationID.x;

    const uint nc = idx / p.OL;
    const uint cur_ol = idx % p.OL;

    const int start = int(cur_ol) * p.s0 - p.p0;
    const int bl = max(start, 0);
    const int el = min(max(start + p.k0, 0), int(p.IL));
    const int window_size = el - bl;

    const bool is_max = p.op == OP_POOL_MAX;
    float res = is_max ? -FLT_MAX : 0.0;
    for (int i = bl + int(tid); i < el; i += BLOCK_SIZE) {
        const float cur = float(data_a[nc * p.IL + uint(i)]);
        res = is_max ? max(res, cur) : res + cur;
    }
    tmp[tid] = res;
    barrier();

    for (uint s = BLOCK_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            tmp[tid] = is_max ? max(tmp[tid], tmp[tid + s]) : tmp[tid] + tmp[tid + s];
        }
        barrier();
    }

    if (tid == 0) {
        float r = tmp[0];
        if (!is_max) {
            r = window_size > 0 ? r / float(window_size) : 0.0;
        }
        data_d[nc * p.OL + cur_ol] = D_TYPE(r);
    }
}
